rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function role() { return me().role; }
    function staff() { return request.auth != null && role() in ['admin', 'trainer']; }

    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || staff());
      allow write: if request.auth != null && role() == 'admin';
      // students may change their own display name, nothing else (trainer names are copied onto courses)
      allow update: if request.auth != null && request.auth.uid == uid && role() == 'student'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);
    }
    // Bootstrap: the first admin is created by hand in the console (see README); it can't be self-created.

    match /courses/{id} {
      // any signed-in user can browse the course catalog (title, trainer, student ids); the tests' results stay private
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && role() == 'admin';
      // admin enrolls students; the course's trainer assigns tests and marks the course completed
      allow update: if request.auth != null && (role() == 'admin'
        || (resource.data.trainerId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['testIds', 'completed'])));
    }

    match /questions/{id} {
      allow read: if request.auth != null;
      // the author or an admin can edit the content (never the author)
      allow update: if request.auth != null && (resource.data.authorId == request.auth.uid || role() == 'admin')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'statement', 'constraints', 'env', 'starter', 'diff', 'topic', 'tests', 'public', 'updatedAt']);
      allow create: if request.auth != null && role() == 'trainer' && request.resource.data.authorId == request.auth.uid;
      allow delete: if request.auth != null && (role() == 'admin' || resource.data.authorId == request.auth.uid);
    }
    match /tests/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && role() == 'trainer' && request.resource.data.authorId == request.auth.uid;
      // an author cannot delete a test while it is open (between its publish and end times); close it first
      allow delete: if request.auth != null && (role() == 'admin' || (resource.data.authorId == request.auth.uid
        && !(resource.data.get('draft', false) == false && 'endAt' in resource.data && resource.data.publishAt <= request.time.toMillis() && request.time.toMillis() <= resource.data.endAt)));
      // the author can edit the title, questions and schedule; after the exam they can also switch proctoring off, which releases its questions to practice
      allow update: if request.auth != null && (role() == 'admin' || resource.data.authorId == request.auth.uid)
        && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['proctored']) && request.resource.data.proctored == false)
          || (resource.data.authorId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'questionIds', 'publishAt', 'endAt', 'durationMin', 'draft', 'updatedAt', 'languages'])));
    }

    // Public XP/streak board. Students write only their own entry. shortcut: client-written, so XP can be faked.
    match /leaderboard/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid && role() == 'student';
    }

    // In-app notifications: staff create them, the owner reads and marks them read.
    match /notifications/{nid} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      // admin: anyone; a trainer: only the students of their own course
      allow create: if request.auth != null && (role() == 'admin'
        || (role() == 'trainer' && request.resource.data.userId in get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.students
            && get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.trainerId == request.auth.uid));
      allow update: if request.auth != null && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }

    // Proctoring evidence for tests marked proctored. Students write their own; staff read all; a student reads their own (to know an exam was auto-submitted).
    // Document ids are uid_courseId_testId_n with n capped, so one student cannot flood the free write quota. Webcam photos are small JPEG data URLs (the free plan has no Storage).
    match /proctor/{id} {
      allow read: if canSeeEvidence(resource.data);
      allow create: if request.auth != null && role() == 'student' && request.resource.data.userId == request.auth.uid
        && id.matches(request.auth.uid + '_' + request.resource.data.courseId + '_' + request.resource.data.testId + '_[0-9]+')
        && int(id.split('_')[3]) < 3000
        && inCourseOf(request.resource.data)
        && get(/databases/$(database)/documents/tests/$(request.resource.data.testId)).data.proctored == true
        && request.resource.data.kind.size() < 40 && request.resource.data.get('detail', '').size() < 300;
    }
    match /snaps/{id} {
      allow read: if canSeeEvidence(resource.data);
      allow create: if request.auth != null && role() == 'student' && request.resource.data.userId == request.auth.uid
        && id.matches(request.auth.uid + '_' + request.resource.data.courseId + '_' + request.resource.data.testId + '_[0-9]+')
        && int(id.split('_')[3]) < 200
        && inCourseOf(request.resource.data)
        && get(/databases/$(database)/documents/tests/$(request.resource.data.testId)).data.proctored == true
        && request.resource.data.img.size() < 60000 && request.resource.data.get('reason', '').size() < 40;
    }

    // When a student ended a test and how many flags they had, so classmates can be ranked without reading proctor logs. Written once, never changed.
    match /finishes/{id} {
      allow read: if request.auth != null && (staff() || inCourseOf(resource.data));
      allow create: if request.auth != null && role() == 'student' && request.resource.data.userId == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.courseId + '_' + request.resource.data.testId
        && inCourseOf(request.resource.data)
        && request.resource.data.flags is int && request.resource.data.flags >= 0 && request.resource.data.flags < 1000
        && request.resource.data.at > request.time.toMillis() - 120000 && request.resource.data.at < request.time.toMillis() + 120000;
    }

    // Manual payment ledger, written when an admin enrolls a student.
    match /payments/{pid} {
      allow read, write: if request.auth != null && role() == 'admin';
    }

    // One doc per (student, course, test) for timed tests. The deadline is fixed when it is created; afterwards the student only writes the heartbeat.
    match /attempts/{aid} {
      allow read: if request.auth != null && (staff() || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && role() == 'student'
        && request.resource.data.userId == request.auth.uid
        && aid == request.auth.uid + '_' + request.resource.data.courseId + '_' + request.resource.data.testId
        && inCourseOf(request.resource.data)
        && get(/databases/$(database)/documents/tests/$(request.resource.data.testId)).data.durationMin is number
        && request.resource.data.deadline == request.resource.data.startedAt + get(/databases/$(database)/documents/tests/$(request.resource.data.testId)).data.durationMin * 60000
        && request.time.toMillis() >= get(/databases/$(database)/documents/tests/$(request.resource.data.testId)).data.publishAt
        && request.time.toMillis() <= get(/databases/$(database)/documents/tests/$(request.resource.data.testId)).data.endAt
        && request.resource.data.startedAt > request.time.toMillis() - 120000 && request.resource.data.startedAt < request.time.toMillis() + 120000;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['beat', 'left']);
    }

    // Webcam photos and logs: the student, an admin, or the trainer of that course (not other trainers).
    function canSeeEvidence(d) {
      return request.auth != null && (d.userId == request.auth.uid || role() == 'admin'
        || get(/databases/$(database)/documents/courses/$(d.courseId)).data.trainerId == request.auth.uid);
    }

    // The student is enrolled in the course and the course has the test.
    function inCourseOf(d) {
      let c = get(/databases/$(database)/documents/courses/$(d.courseId)).data;
      return request.auth.uid in c.students && d.testId in c.testIds;
    }

    // Submissions to a timed test are refused after the attempt's deadline (30 s of grace for the auto-submit).
    function inTime(d) {
      return d.testId == 'practice'
        || !('durationMin' in get(/databases/$(database)/documents/tests/$(d.testId)).data)
        || (exists(/databases/$(database)/documents/attempts/$(request.auth.uid + '_' + d.courseId + '_' + d.testId))
            && request.time.toMillis() <= get(/databases/$(database)/documents/attempts/$(request.auth.uid + '_' + d.courseId + '_' + d.testId)).data.deadline + 30000);
    }

    // One doc per (student, course, test, question): the same test in two courses has separate results. Free students may only create it (one attempt); subscribers may overwrite it.
    match /submissions/{sid} {
      // students of a course can see everyone's scores on its tests, open or closed (the app only shows totals, never another student's code)
      allow read: if request.auth != null && (staff() || resource.data.userId == request.auth.uid
        || (resource.data.testId != 'practice' && inCourseOf(resource.data)));
      allow create: if request.auth != null && role() == 'student'
        && request.resource.data.userId == request.auth.uid
        && sid == request.auth.uid + '_' + request.resource.data.courseId + '_' + request.resource.data.testId + '_' + request.resource.data.questionId
        && ((request.resource.data.testId == 'practice' && request.resource.data.courseId == 'practice')
            || (exists(/databases/$(database)/documents/tests/$(request.resource.data.testId)) && inCourseOf(request.resource.data)))
        && inTime(request.resource.data);
      allow update: if request.auth != null && role() == 'student' && me().subscribed == true && resource.data.testId == 'practice'
        && request.resource.data.userId == request.auth.uid && inTime(request.resource.data)
        && request.resource.data.courseId == resource.data.courseId && request.resource.data.testId == resource.data.testId
        && request.resource.data.questionId == resource.data.questionId;
    }
  }
}
